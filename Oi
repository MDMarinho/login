# Função para calcular a média das notas de um aluno
def calcular_media(notas):
    return sum(notas) / len(notas)

# Lista para armazenar as médias dos alunos
medias = []

# Leitura das notas dos alunos
for i in range(1, 6):  # Para 5 alunos
    print(f"Aluno {i}:")
    notas = []
    for j in range(1, 5):  # Para 4 notas de cada aluno
        nota = float(input(f"Digite a nota {j}: "))
        notas.append(nota)
    
    media = calcular_media(notas)
    medias.append(media)

# Encontrando a maior e a menor média
maior_media = max(medias)
menor_media = min(medias)

# Exibindo os resultados
print(f"\nA maior média é: {maior_media:.2f}")
print(f"A menor média é: {menor_media:.2f}")
